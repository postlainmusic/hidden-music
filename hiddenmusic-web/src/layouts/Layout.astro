---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { PlayerProvider } from '../context/PlayerContext';
import GlobalAudioPlayer from '../components/ui/GlobalAudioPlayer';
import Navbar from '../components/ui/Navbar';
import Footer from '../components/ui/Footer';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hidden Music Vault | The Underground Music Terminal',
  description = 'Nền tảng lưu trữ, phát trực tuyến và bảo tồn âm nhạc & MV unreleased độc quyền trên nền tảng Cloudflare R2.',
} = Astro.props;
---

<!doctype html>
<html lang="vi" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#07080c" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ViewTransitions />
  </head>
  <body class="bg-[#07080c] text-slate-100 min-h-screen relative overflow-x-hidden">
    {/* Analog Grain & CRT Scanlines */}
    <div class="tv-grain-overlay" aria-hidden="true"></div>
    <div class="crt-scanlines" aria-hidden="true"></div>

    <PlayerProvider client:load>
      {/* Top Navbar */}
      <Navbar client:load />

      {/* Main Page Slot */}
      <main class="relative z-10 w-full min-h-screen">
        <slot />
      </main>

      {/* Persistent Bottom Audio Player - Never stops when navigating */}
      <GlobalAudioPlayer transition:persist client:load />

      {/* Footer */}
      <Footer client:load />
    </PlayerProvider>

    {/* Service Worker Registration */}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
