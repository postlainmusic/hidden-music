{
  "appId": "com.postlain.hiddenmusic",
  "appName": "Hidden Music Vault",
  "webDir": "out",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://postlain.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorCookies": {
      "enabled": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
