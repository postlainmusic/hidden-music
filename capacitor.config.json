{
  "appId": "com.postlain.hiddenmusic",
  "appName": "Hidden Music",
  "webDir": "public",
  "server": {
    "url": "https://music.postlain.com",
    "cleartext": true,
    "allowNavigation": [
      "music.postlain.com",
      "*.postlain.com",
      "*.supabase.co",
      "*.cloudflare.com",
      "*.r2.dev"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#09090d"
  }
}
